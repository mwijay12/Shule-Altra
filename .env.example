# ---------------------------------------------------------------------------
# Shule Altra — environment template
#
#   cp .env.example .env.local
#
# Everything below is optional for the demo: with no env file at all the hub
# runs in demo mode against the offline dataset in src/lib/demo.
# ---------------------------------------------------------------------------

# DEMO MODE (default ON): Firebase is swapped for the offline layer in
# src/lib/demo, seeded with Mwalimu Nyerere Secondary School data.
# Set to "false" to run against a real Firebase project.
NEXT_PUBLIC_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Firebase (required when NEXT_PUBLIC_DEMO_MODE=false)
#
# Paste the web app config object from Firebase console → Project settings →
# Your apps → SDK setup. One line of JSON, no line breaks.
#
# These keys are public by design; firestore.rules and storage.rules are what
# actually protect the data (see `firebase deploy --only firestore:rules,storage`).
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"...","authDomain":"your-project.firebaseapp.com","projectId":"your-project","storageBucket":"your-project.appspot.com","messagingSenderId":"...","appId":"..."}

# The public origin used inside emails ("open your report card" links).
# NEXT_PUBLIC_APP_URL=https://shule-altra-demo.vercel.app

# ---------------------------------------------------------------------------
# Email — guardians and staff
#
# Priority: SMTP (Nodemailer) → RESEND_API_KEY → dry run.
# With nothing set the mail room still renders and counts every message; it
# just does not deliver. Set one of the two blocks below to go live.
# ---------------------------------------------------------------------------

# --- SMTP (Gmail, Zoho, cPanel, SES SMTP, any relay) -----------------------
# The password is an APP PASSWORD, not the account password. For Gmail:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# Spaces in the app password are stripped automatically.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@yourdomain.co.tz
# SMTP_PASS=xxxxxxxxxxxxxxxx
# SMTP_FROM=Shule Altra <you@yourdomain.co.tz>

# Copy every outgoing school message to the office, so nobody can claim a
# reminder was never sent. BCC — parents never see it.
# ADMIN_NOTIFICATION_EMAIL=office@yourdomain.co.tz

# Gmail punishes bursts. These cap one click and one day; the mail room
# refuses (with a reason) instead of silently truncating.
# SMTP_MAX_PER_SEND=200
# SMTP_DAILY_LIMIT=400

# The demo register's parent addresses are invented. Live delivery refuses them
# by default, because 97 bounces would damage the sending domain. Only set this
# if you truly want mail sent to `@parents.mnyerere.sc.tz`.
# EMAIL_ALLOW_DEMO_DELIVERY=false

# --- Resend (better for large batches) -------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Shule Altra <no-reply@shulealtra.co.tz>
# EMAIL_REPLY_TO=office@shulealtra.co.tz

# ---------------------------------------------------------------------------
# Learner photographs (PDPA)
#
# A child's photograph is sensitive personal data. Choose what this school keeps:
#   none      no photographs at all — ID cards print with initials
#   optional  (default) a photograph only with a guardian's consent
#   required  every learner should have one; consent is still recorded
#
# Bulk import (Student Directory → Import photos) matches a folder by admission
# number: ADM-2026-014.jpg. The policy above still governs whether it may run.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_PHOTO_POLICY=optional

# ---------------------------------------------------------------------------
# Email test mode — try the whole pipeline before there are real parents
#
# Redirects every message to these inboxes with a [TEST] subject prefix. The
# audience is still computed from the register; only the envelope changes.
# ---------------------------------------------------------------------------
# EMAIL_TEST_MODE=true
# EMAIL_TEST_RECIPIENTS=davidbyanmwijage@gmail.com

# ---------------------------------------------------------------------------
# Optional: Gemini for the AI tools panel
# ---------------------------------------------------------------------------
# GOOGLE_GENAI_API_KEY=your_gemini_key_here
