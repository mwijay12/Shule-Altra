# ---------------------------------------------------------------------------
# Shule Altra — environment template
# ---------------------------------------------------------------------------
# DEMO MODE (default ON): the app swaps Firebase for the offline demo layer
# in src/lib/demo, seeded with Mwalimu Nyerere Secondary School data.
# Nothing else is required to run a full demo.
NEXT_PUBLIC_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Set NEXT_PUBLIC_DEMO_MODE=false and fill the values below to run against a
# real Firebase project + Gemini.
# ---------------------------------------------------------------------------
# GOOGLE_GENAI_API_KEY=your_gemini_key_here
# NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"...","projectId":"...","appId":"...","authDomain":"..."}
