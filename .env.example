# ---------------------------------------------------------------------------
# Shule Altra — environment template
#
#   cp .env.example .env.local
#
# Everything below is optional for the demo: with no env file at all the hub
# runs in demo mode against the offline dataset in src/lib/demo.
# ---------------------------------------------------------------------------

# DEMO MODE (default ON): Firebase is swapped for the offline layer in
# src/lib/demo, seeded with Mwalimu Nyerere Secondary School data.
# Set to "false" to run against a real Firebase project.
NEXT_PUBLIC_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Firebase (required when NEXT_PUBLIC_DEMO_MODE=false)
#
# Paste the web app config object from Firebase console → Project settings →
# Your apps → SDK setup. One line of JSON, no line breaks.
#
# These keys are public by design; firestore.rules and storage.rules are what
# actually protect the data (see `firebase deploy --only firestore:rules,storage`).
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"...","authDomain":"your-project.firebaseapp.com","projectId":"your-project","storageBucket":"your-project.appspot.com","messagingSenderId":"...","appId":"..."}

# The public origin used inside emails ("open your report card" links).
# NEXT_PUBLIC_APP_URL=https://shule-altra-demo.vercel.app

# ---------------------------------------------------------------------------
# Email — guardians and staff
#
# Leave RESEND_API_KEY unset and the mail room runs in dry-run mode: every
# message is rendered and counted, nothing is delivered. Set it and the same
# button sends for real. Get a key at https://resend.com/api-keys.
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Shule Altra <no-reply@shulealtra.co.tz>
# EMAIL_REPLY_TO=office@shulealtra.co.tz

# ---------------------------------------------------------------------------
# Optional: Gemini for the AI tools panel
# ---------------------------------------------------------------------------
# GOOGLE_GENAI_API_KEY=your_gemini_key_here
