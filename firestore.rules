rules_version = '2';

/**
 * Shule Altra — Firestore security rules.
 *
 * The shape of the data is `schools/{schoolId}/{collection}/{docId}`, and the
 * only source of authority is the staff record at `schools/{schoolId}/staff/{uid}`
 * whose `role` field is one of ADMIN | TEACHER | ACCOUNTANT | BURSAR | VIEWER.
 * Nothing is trusted from the client: no role in localStorage, no role in a
 * request body, no role from a custom claim that was never set.
 *
 * The same three bands the document registry uses:
 *   money   → ADMIN, BURSAR, ACCOUNTANT
 *   learning→ ADMIN, TEACHER
 *   estate  → ADMIN, BURSAR, ACCOUNTANT (assets, hostel, transport)
 *   identity→ ADMIN only (staff records, settings)
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    match /schools/{schoolId} {
      function staffPath() {
        return /databases/$(database)/documents/schools/$(schoolId)/staff/$(request.auth.uid);
      }
      function isStaff() {
        return signedIn() && exists(staffPath());
      }
      function role() {
        return isStaff() ? get(staffPath()).data.role : '';
      }
      function inRole(roles) {
        return isStaff() && role() in roles;
      }
      function money() {
        return inRole(['ADMIN', 'BURSAR', 'ACCOUNTANT']);
      }
      function learning() {
        return inRole(['ADMIN', 'TEACHER']);
      }

      // ── identity ─────────────────────────────────────────────────────────
      // A staff member may always read their own record (that is how the hub
      // resolves a role); only an administrator may touch anybody's.
      match /staff/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || inRole(['ADMIN']));
        allow list: if inRole(['ADMIN', 'TEACHER', 'BURSAR', 'ACCOUNTANT']);
        allow create, update, delete: if inRole(['ADMIN']);
      }

      // ── learner records ──────────────────────────────────────────────────
      match /students/{studentId} {
        allow read: if inRole(['ADMIN', 'TEACHER', 'BURSAR', 'ACCOUNTANT', 'VIEWER']);
        allow create, update: if learning();
        allow delete: if inRole(['ADMIN']);
      }

      // ── learning ─────────────────────────────────────────────────────────
      match /grades/{gradeId} {
        allow read, write: if learning();
      }
      match /attendance/{entryId} {
        allow read, write: if learning();
      }
      match /timetable/{slotId} {
        allow read: if isStaff();
        allow write: if learning();
      }
      match /academics/{docId} {
        allow read: if isStaff();
        allow write: if learning();
      }

      // ── money ────────────────────────────────────────────────────────────
      match /transactions/{transactionId} {
        allow read, write: if money();
      }
      match /petty_cash/{entryId} {
        allow read, write: if money();
      }
      match /canteen_sales/{saleId} {
        allow read, write: if money();
      }
      match /fees/{feeId} {
        allow read: if inRole(['ADMIN', 'BURSAR', 'ACCOUNTANT', 'TEACHER']);
        allow write: if money();
      }

      // ── estate ───────────────────────────────────────────────────────────
      match /assets/{assetId} {
        allow read, write: if inRole(['ADMIN', 'BURSAR', 'ACCOUNTANT']);
      }
      match /hostels/{hostelId} {
        allow read, write: if inRole(['ADMIN', 'BURSAR']);
      }
      match /routes/{routeId} {
        allow read, write: if inRole(['ADMIN', 'BURSAR']);
      }

      // ── communication audit ──────────────────────────────────────────────
      // Written by the server (Admin SDK bypasses these rules); staff may read
      // the log so a school can show what was sent and to how many people.
      match /mail_log/{entryId} {
        allow read: if inRole(['ADMIN', 'BURSAR', 'ACCOUNTANT']);
        allow write: if false;
      }

      // Public marketing content for the landing page. It names no learner and
      // carries no money; only an administrator may publish it.
      match /config/landing {
        allow read: if true;
        allow write: if inRole(['ADMIN']);
      }

      // ── anything else in a school is administrator-only ──────────────────
      match /{collection}/{docId} {
        allow read, write: if inRole(['ADMIN']);
      }
    }

    // Nothing outside a school is readable by a browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
