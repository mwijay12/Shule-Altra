rules_version = '2';

/**
 * Shule Altra — Firestore security rules.
 *
 * The shape of the data is `schools/{schoolId}/{collection}/{docId}`, and the
 * only source of authority is the staff record at `schools/{schoolId}/staff/{uid}`
 * whose `role` field is one of SUPER_ADMIN | ADMIN | TEACHER | ACCOUNTANT |
 * BURSAR | VIEWER, plus the install owner identified by a verified Google email.
 * Nothing is trusted from the client: no role in localStorage, no role in a
 * request body, no role from a custom claim that was never set.
 *
 * The same three bands the document registry uses:
 *   money   → ADMIN, BURSAR, ACCOUNTANT
 *   learning→ ADMIN, TEACHER
 *   estate  → ADMIN, BURSAR, ACCOUNTANT (assets, hostel, transport)
 *   identity→ ADMIN only (staff records, settings)
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The install owner. This is the real gate for branding and identity: the
    // email list in src/lib/auth/super-admin.ts only decides what the UI shows.
    // Keep the two in sync. Requires a verified address so an unverified
    // password account cannot claim it.
    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'davidbyanmwijage@gmail.com';
    }

    match /schools/{schoolId} {
      function staffPath() {
        return /databases/$(database)/documents/schools/$(schoolId)/staff/$(request.auth.uid);
      }
      function isStaff() {
        return isSuperAdmin() || (signedIn() && exists(staffPath()));
      }
      function role() {
        return isStaff() ? get(staffPath()).data.role : '';
      }
      function inRole(roles) {
        // The owner holds every staff capability without needing a staff record.
        return isSuperAdmin() || (isStaff() && role() in roles);
      }
      function money() {
        return inRole(['ADMIN', 'BURSAR', 'ACCOUNTANT']);
      }
      function learning() {
        return inRole(['ADMIN', 'TEACHER']);
      }

      // ── audit log ────────────────────────────────────────────────────────
      // Append-only, enforced here rather than trusted to the client.
      //
      // Any staff member may append the entry describing what they just did,
      // but NOBODY may update or delete one — not an administrator, not the
      // install owner. That is what makes the hash chain meaningful: an editor
      // would have to rewrite every later entry, and the rules forbid touching
      // any of them.
      //
      // The entry must name the signed-in user as its actor, so a teacher
      // cannot file an entry attributing a change to the bursar.
      match /audit/{entryId} {
        allow read: if inRole(['ADMIN', 'BURSAR', 'ACCOUNTANT']);

        allow create: if isStaff()
          && request.resource.data.actor.uid == request.auth.uid
          && request.resource.data.seq is int
          && request.resource.data.seq > 0
          && request.resource.data.hash is string
          && request.resource.data.hash.size() == 64
          && request.resource.data.prevHash is string
          && request.resource.data.action in [
               'create', 'update', 'delete', 'sign_in', 'sign_out',
               'export', 'send', 'publish'
             ];

        // No update. No delete. History is not editable by design.
        allow update, delete: if false;
      }

      // ── identity ─────────────────────────────────────────────────────────
      // A staff member may always read their own record (that is how the hub
      // resolves a role); only an administrator may touch anybody's.
      match /staff/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || inRole(['ADMIN']));
        allow list: if inRole(['ADMIN', 'TEACHER', 'BURSAR', 'ACCOUNTANT']);
        allow create, update, delete: if inRole(['ADMIN']);
        match /teachingAssignments/{assignmentId} {
          allow read: if inRole(['ADMIN']) || (signedIn() && request.auth.uid == uid && inRole(['TEACHER']));
          allow create, update: if inRole(['ADMIN'])
            && request.resource.data.className is string
            && request.resource.data.subject is string
            && assignmentId == request.resource.data.className + '|' + request.resource.data.subject;
          allow delete: if inRole(['ADMIN']);
        }
      }

      // ── learner records ──────────────────────────────────────────────────
      match /students/{studentId} {
        allow read: if inRole(['ADMIN', 'TEACHER', 'BURSAR', 'ACCOUNTANT', 'VIEWER']);
        allow create: if learning();
        // Finance roles may update only the fields changed by a payment entry.
        allow update: if inRole(['ADMIN'])
          || (learning() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'statusUpdatedAt', 'class']))
          || (money() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalPaid', 'balance', 'lastPaymentDate', 'paymentStatus']));
        allow delete: if inRole(['ADMIN']);
        match /statusHistory/{entryId} {
          allow read: if inRole(['ADMIN']);
          allow create: if inRole(['ADMIN'])
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.from in ['Active', 'Suspended', 'Archived']
            && request.resource.data.to in ['Active', 'Suspended', 'Archived']
            && request.resource.data.reason is string
            && request.resource.data.reason.size() >= 5
            && request.resource.data.reason.size() <= 500;
          allow update, delete: if false;
        }
      }

      // ── learning ─────────────────────────────────────────────────────────
      match /grades/{gradeId} {
        allow read: if learning();
        // Teachers can create marks only for their own class/subject assignment.
        // Staff document IDs must match Firebase Auth UIDs. Existing marks may
        // only be edited or deleted by an administrator.
        allow create: if inRole(['ADMIN']) || (
          inRole(['TEACHER'])
          && get(staffPath()).data.get('active', true) == true
          && request.resource.data.recordedByUid == request.auth.uid
          && request.resource.data.studentId is string
          && !request.resource.data.studentId.matches('.*[|%/].*')
          && request.resource.data.academicYear is string
          && request.resource.data.academicYear.matches('^[0-9]{4}$')
          && request.resource.data.subject is string
          && !request.resource.data.subject.matches('.*[|%/].*')
          && request.resource.data.class is string
          && request.resource.data.score is number
          && request.resource.data.score >= 0 && request.resource.data.score <= 100
          && request.resource.data.term in ['Term 1', 'Term 2', 'Term 3']
          && request.resource.data.examType in ['Mid-Term', 'Annual', 'Mock']
          && gradeId == 'entry|' + request.resource.data.studentId + '|' + request.resource.data.term + '|' + request.resource.data.examType + '|' + request.resource.data.subject + '|' + request.resource.data.academicYear
          && exists(/databases/$(database)/documents/schools/$(schoolId)/students/$(request.resource.data.studentId))
          && get(/databases/$(database)/documents/schools/$(schoolId)/students/$(request.resource.data.studentId)).data.class == request.resource.data.class
          && exists(/databases/$(database)/documents/schools/$(schoolId)/staff/$(request.auth.uid)/teachingAssignments/$(request.resource.data.class + '|' + request.resource.data.subject))
        );
        allow update, delete: if inRole(['ADMIN']);
      }
      // Evidence of a reviewed correction is append-only for administrators.
      match /gradeCorrections/{correctionId} {
        allow read: if inRole(['ADMIN']);
        allow create: if inRole(['ADMIN'])
          && request.resource.data.action == 'remove_duplicate'
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.keptId is string
          && request.resource.data.removedId is string
          && request.resource.data.reason is string
          && request.resource.data.reason.size() >= 5
          && request.resource.data.reason.size() <= 500;
        allow update, delete: if false;
      }
      match /attendance/{entryId} {
        allow read, write: if learning();
      }
      match /timetable/{slotId} {
        allow read: if isStaff();
        allow write: if learning();
      }
      match /academics/{docId} {
        allow read: if isStaff();
        allow write: if learning();
      }

      // ── money ────────────────────────────────────────────────────────────
      match /transactions/{transactionId} {
        allow read, write: if money();
      }
      // Supplier contacts are restricted to finance staff and administrators.
      function validSupplier(data) {
        return data.keys().hasOnly(['name', 'contactName', 'phone', 'email', 'category', 'notes', 'revision', 'createdAt', 'updatedAt', 'updatedByUid'])
          && data.name is string && data.name.size() >= 2 && data.name.size() <= 120
          && data.contactName is string && data.contactName.size() <= 120
          && data.phone is string && (data.phone == '' || data.phone.matches('^(\\+255|0)[0-9]{9}$'))
          && data.email is string && data.email.size() <= 254
          && (data.phone != '' || data.email != '')
          && data.category is string && data.category.size() <= 120
          && data.notes is string && data.notes.size() <= 500
          && data.revision is int && data.updatedByUid == request.auth.uid
          && data.updatedAt == request.time;
      }
      match /suppliers/{supplierId} {
        allow read: if money();
        allow create: if money() && validSupplier(request.resource.data)
          && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time;
        allow update: if money() && validSupplier(request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
      // Paid expenses are a separate append-only register, not fee transactions
      // or the older petty-cash approval requests.
      match /expense_entries/{entryId} {
        allow read: if money();
        allow create: if money()
          && request.resource.data.keys().hasOnly(['date', 'category', 'description', 'amount', 'payee', 'reference', 'recordedByUid', 'recordedByEmail', 'createdAt'])
          && request.resource.data.recordedByUid == request.auth.uid
          && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.category in ['Supplies', 'Food', 'Transport', 'Utilities', 'Maintenance', 'Salaries', 'Other']
          && request.resource.data.description is string && request.resource.data.description.size() >= 3 && request.resource.data.description.size() <= 300
          && request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000000
          && request.resource.data.payee is string && request.resource.data.payee.size() <= 120
          && request.resource.data.reference is string && request.resource.data.reference.size() <= 120
          && request.resource.data.recordedByEmail is string && request.resource.data.recordedByEmail.size() <= 320
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /petty_cash/{entryId} {
        allow read, write: if money();
      }
      match /canteen_sales/{saleId} {
        allow read, write: if money();
      }
      match /fees/{feeId} {
        allow read: if inRole(['ADMIN', 'BURSAR', 'ACCOUNTANT', 'TEACHER']);
        allow write: if money();
      }

      // ── estate ───────────────────────────────────────────────────────────
      match /assets/{assetId} {
        allow read, write: if inRole(['ADMIN', 'BURSAR', 'ACCOUNTANT']);
      }
      match /hostels/{hostelId} {
        allow read, write: if inRole(['ADMIN', 'BURSAR']);
      }
      match /routes/{routeId} {
        allow read, write: if inRole(['ADMIN', 'BURSAR']);
      }

      // ── communication audit ──────────────────────────────────────────────
      // Written by the server (Admin SDK bypasses these rules); staff may read
      // the log so a school can show what was sent and to how many people.
      match /mail_log/{entryId} {
        allow read: if inRole(['ADMIN', 'BURSAR', 'ACCOUNTANT']);
        allow write: if false;
      }

      // Public marketing content for the landing page. It names no learner and
      // carries no money; only an administrator may publish it.
      match /config/landing {
        allow read: if true;
        allow write: if inRole(['ADMIN']);
      }

      // Palette and type pairing. Public-readable because the theme is applied
      // before anyone signs in (login screen included) and it carries no
      // personal data — only colours and font names.
      match /config/branding {
        allow read: if true;
        allow write: if inRole(['ADMIN']);
      }

      // Sidebar visibility is a presentation preference, not an access rule.
      match /config/sidebar {
        allow read: if isStaff();
        allow write: if inRole(['ADMIN']);
      }

      // Letterhead identity. Every staff member who prints a document needs to
      // read it; only an administrator or the owner may change it.
      match /config/identity {
        allow read: if isStaff();
        allow write: if inRole(['ADMIN']);
      }

      // ── anything else in a school is administrator-only ──────────────────
      match /{collection}/{docId} {
        allow read, write: if collection != 'gradeCorrections' && collection != 'expense_entries' && collection != 'suppliers' && inRole(['ADMIN']);
      }
    }

    // Nothing outside a school is readable by a browser.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
